{
  "id": "lazer.spotube",
  "name": "Spotube",
  "version": "0.1.5",
  "description": "专为 Lazer 打造的 Spotube (Spotify) 混合架构扩展插件：基于 Spotify 官方元数据与 YouTube 纯净音频流，支持 Cookie 登录与全球榜单检索。",
  "author": "VincentZyu",
  "entry": "main.lua",
  "apiVersion": 1,
  "provider": "spotube",
  "minAppVersion": "2.0.210",
  "capabilities": [
    "search",
    "lyrics",
    "playlists",
    "favorites",
    "browseAlbums",
    "homeFeed",
    "charts"
  ],
  "auth": [
    "qr",
    "cookie"
  ],
  "permissions": {
    "network": [
      "open.spotify.com",
      "accounts.spotify.com",
      "*.spotify.com",
      "api.spotify.com",
      "api-partner.spotify.com",
      "spclient.wg.spotify.com",
      "clienttoken.spotify.com",
      "*.spotifycdn.com",
      "*.scdn.co",
      "*.googlevideo.com",
      "music.youtube.com",
      "www.youtube.com",
      "youtube.com",
      "*.piped.private.coffee",
      "pipedapi.kavin.rocks",
      "lrclib.net"
    ],
    "socketServer": [
      "127.0.0.1:28795",
      "localhost:28795"
    ],
    "storage": true
  }
}

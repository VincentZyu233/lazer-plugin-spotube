{
  "id": "community.spotube.music",
  "name": "Spotube",
  "version": "0.2.0",
  "description": "专为 Lazer 打造的 Spotube (Spotify) 混合架构扩展插件：支持快捷授权登录、云端歌单与收藏同步、艺人主页生态、智能双层音频流缓存秒开、全域检索及 LRCLIB 逐行动感歌词。",
  "author": "VincentZyu",
  "entry": "main.lua",
  "apiVersion": 1,
  "provider": "spotube",
  "minAppVersion": "2.0.210",
  "capabilities": [
    "search",
    "lyrics",
    "playlists",
    "userPlaylists",
    "favorites",
    "artist",
    "artistSongs",
    "artistAlbums",
    "browseAlbums",
    "homeFeed",
    "charts"
  ],
  "auth": [
    "qr",
    "cookie"
  ],
  "permissions": {
    "network": [
      "open.spotify.com",
      "accounts.spotify.com",
      "*.spotify.com",
      "api.spotify.com",
      "api-partner.spotify.com",
      "spclient.wg.spotify.com",
      "clienttoken.spotify.com",
      "*.spotifycdn.com",
      "*.scdn.co",
      "*.googlevideo.com",
      "music.youtube.com",
      "www.youtube.com",
      "youtube.com",
      "*.piped.private.coffee",
      "pipedapi.kavin.rocks",
      "lrclib.net"
    ],
    "socketServer": [
      "127.0.0.1:28795",
      "localhost:28795"
    ],
    "storage": true
  }
}
